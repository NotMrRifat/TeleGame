# Telegram Bot Credentials
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_sample_token
BOT_USERNAME=TeleGameMasterBot
BOT_ID=123456789

# Webhook & Serverless Settings
WEBHOOK_SECRET=super_secret_webhook_token_32_chars_long
WEBHOOK_URL=https://telegame.vercel.app
WEBHOOK_PATH=/webhook

# Environment & Application Metadata
APP_ENV=development
ENVIRONMENT=development
APP_NAME=TeleGame
DEBUG=True
LOG_LEVEL=INFO

# Database Connection (Supabase PostgreSQL / Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/telegame
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
REDIS_URL=redis://localhost:6379/0

# Security & Encryption Secrets
SECRET_KEY=super-secret-key-change-this-in-production-min-32-chars
SESSION_SECRET=session-secret-key-change-this-in-production-min-32-chars
JWT_SECRET=jwt-secret-key-change-this-in-production-min-32-chars
ENCRYPTION_KEY=encryption-secret-key-change-this-32b

# Access Control (Comma-separated Telegram User IDs)
ADMIN_IDS=12345678,87654321
SUPER_ADMIN_IDS=12345678
OWNER_ID=12345678

# Localization & Region
SUPPORTED_LANGUAGES=en,bn
DEFAULT_LANGUAGE=bn
TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=COINS
DEFAULT_THEME=classic
DEFAULT_AVATAR=default

# Game & Session Timeouts (in Seconds)
TURN_TIMEOUT=60
LOBBY_TIMEOUT=180
GAME_TIMEOUT=1800
SESSION_TIMEOUT=3600
MAX_ACTIVE_GAMES_PER_GROUP=1
MAX_PLAYERS_PER_GAME=32
RATE_LIMIT_SECONDS=2

# Feature Flags
ENABLE_ANALYTICS=True
ENABLE_LEADERBOARD=True
ENABLE_QUESTS=True
ENABLE_CLANS=True
ENABLE_ECONOMY=True
ENABLE_SHOP=True
ENABLE_NOTIFICATIONS=True
ENABLE_LOGGING=True
ENABLE_DEBUG_COMMANDS=False
